# Server Configuration
PORT=5000

# CORS Configuration for Production
# In production on Render, set this to your Netlify site URL (e.g., https://bhumi-vikas-sahayak.netlify.app)
CLIENT_ORIGIN=http://localhost:3000

# Authentication & Session Security
# Generate a strong, random secret string in production (e.g., openssl rand -base64 32)
JWT_SECRET=your_custom_jwt_secret_key_here

# Anthropic Claude API Configuration (Platform Credits)
# Model options: claude-sonnet-5, claude-3-5-sonnet-latest, claude-haiku-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Cerebras Cloud API Configuration (Alternative fast inference)
CEREBRAS_API_KEY=
